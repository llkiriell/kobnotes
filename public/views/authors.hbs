<div class="list-group list-authors pt-2">
  {{#each authors}}
    <a href="/libraries/{{../libraryId}}/authors/{{id}}/bookmarks" class="list-group-item list-group-item-action border-0 border-bottom"
      data-id-autor="{{id}}" data-nombre-autor="{{Autor}}"
      data-cant-libros="{{BookCount}}" data-cant-anotaciones="{{Annotations}}" data-cant-subrayados="{{Highlights}}"
      data-cant-citas="{{Quotes}}" data-cant-palabras="{{Words}}" data-cant-definiciones="{{Definitions}}"
      data-cant-vocabulario="{{Vocabulary}}" data-cant-marcadores="{{Bookmarks}}">
      <div class="d-flex w-100 justify-content-between">
        <h5 class="labrada mb-1">{{Autor}}</h5>
      </div>
      <div class="d-flex w-100 justify-content-between">
        <small title="Libros"><i class="fas fa-books pe-1"></i>{{BookCount}}</small>
        <small>
          <span title="Anotaciones"><i class="fad fa-pencil pe-1"></i>{{Annotations}}</span>
          <span title="Subrayados"><i class="fad fa-highlighter ps-2 pe-1"></i>{{Highlights}}</span>
          <span title="Citas"><i class="fad fa-quote-right ps-2 pe-1"></i>{{Quotes}}</span>
          <span title="Vocabulario"><i class="fad fa-book ps-2 pe-1"></i>{{Vocabulary}}</span>
          <span title="Definiciones"><i class="fad fa-graduation-cap ps-2 pe-1"></i>{{Definitions}}</span>
          <span title="Palabras"><i class="fad fa-font ps-2 pe-1"></i>{{Words}}</span>
        </small>
      </div>
    </a>
  {{/each}}
</div> 