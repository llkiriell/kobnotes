<div class="row mb-3">
  <div class="col-12">
    <h2 class="labrada">Marcadores de {{author.Autor}}</h2>
    <p><i class="fas fa-books pe-1"></i> {{author.BookCount}} libros | <i class="fas fa-inbox pe-1"></i> {{author.Bookmarks}} marcadores</p>
  </div>
</div>

<div id="mc-bookmarks-list" class="row">
  {{#each booksWithBookmarks}}
  <div class="row mb-4">
    <div id="container-list" class="col-xxl-12">
      <div id="container_database_info" class="col-xxl-12 px-3 pt-3 d-flex">
        <span class="badge rounded-pill text-bg-dark">
          <i class="fad fa-plug text-warning me-1"></i>{{../library.name}}
        </span>
      </div>
      <div id="container_book_info" class="col-xxl-12 p-3" data-id-libro="{{book.VolumeID}}">
        <p id="p_title_book" class="h3 labrada ">{{book.BookTitle}}</p>
        <p id="p_autor_book" class="h5 labrada pb-3"><i class="fad fa-feather-alt pe-1"></i>{{book.Autor}}</p>
        <div class="d-flex justify-content-between align-items-center">
          <small><i class="fas fa-inbox pe-1"></i>{{book.total}} Resaltes</small>
          <small>
            <span id="qty_notes" title="Anotaciones"><i class="fad fa-pencil pe-1"></i>{{book.Annotations}}</span>
            <span id="qty_hightlights" title="Subrayados"><i class="fad fa-highlighter ps-2 pe-1"></i>{{book.Highlights}}</span>
            <span id="qty_quotes" title="Citas"><i class="fad fa-quote-right ps-2 pe-1"></i>{{book.Quotes}}</span>
            <span id="qty_vocabulary" title="Vocabulario"><i class="fad fa-book ps-2 pe-1"></i>{{book.Vocabulary}}</span>
            <span id="qty_definitions" title="Definiciones"><i class="fad fa-graduation-cap ps-2 pe-1"></i>{{book.Definitions}}</span>
            <span id="qty_words" title="Palabras"><i class="fad fa-font ps-2 pe-1"></i>{{book.Words}}</span>
          </small>
        </div>
        <hr id="book_hr">
      </div>
      <div id="bookmark_list" class="container">
        {{#if highlights.length}}
          {{#eachListBookmarks highlights}}
          {{/eachListBookmarks}}
        {{else}}
          <p class="text-center">No hay marcadores para este libro</p>
        {{/if}}
      </div>
    </div>
  </div>
  {{/each}}
  
  {{#unless booksWithBookmarks.length}}
  <div class="row">
    <div class="col-12 text-center py-5">
      <h3 class="labrada">No hay marcadores para este autor</h3>
    </div>
  </div>
  {{/unless}}
</div> 