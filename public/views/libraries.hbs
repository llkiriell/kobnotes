<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{titulo}} | KbNotes</title>
  <link rel="stylesheet" href="/static/libraries/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/static/css/general.css">
  <link rel="stylesheet" href="/static/libraries/fontawesome/css/all.min.css">
</head>
<style>
  .content-data{
    width: 100% !important;
  }

  .card{
    border-color: #dee2e6 !important;
  }

  @media (min-width: 769px) {
    .card{
      width: 350px !important;
    }
  }
  
  .card.active-library {
    border-color: #ffc107 !important;
    box-shadow: 0 0 0 0.25rem rgba(255, 193, 7, 0.25);
  }
  
  .no-libraries {
    height: 70vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }
  
  .side-menu-options>li.active {
    color: black !important;
    background-color: #ffc107;
  }

  .side-menu-options>li:not(.active):hover{
    background-color: #dee2e6;
  }
</style>
<body>

  <main>
    <div class="side-menu">
      <div class="side-menu-logo">
        <a href="/" class="link-dark text-decoration-none" data-bs-toggle="tooltip" data-bs-placement="right"
          data-bs-original-title="Icon-only" data-bcup-haslogintext="no">
          <span class="iconify" data-icon="mdi:book-open-page-variant" data-width="20" data-height="20"></span>
          <span class="visually-hidden">Icon-only</span>
        </a>
      </div>
      <ul class="side-menu-options">
        <li class="active">
          <a href="/libraries" class="text-reset py-3 rounded-0" aria-current="page" data-bs-toggle="tooltip"
            data-bs-placement="right" data-bs-title="Librerías" aria-label="Librerías" data-bs-original-title="Librerías" data-bcup-haslogintext="no">
            <i class="fad fa-line-columns"></i>
          </a>
        </li>
        {{#if activeLibrary}}
        <li>
          <a href="/libraries/{{activeLibrary.id}}/books" class="text-reset py-3 rounded-0" data-bs-toggle="tooltip" data-bs-placement="right"
            data-bs-title="Libros" aria-label="Libros" data-bs-original-title="Libros" data-bcup-haslogintext="no">
            <i class="fad fa-books"></i>
          </a>
        </li>
        <li>
          <a href="/libraries/{{activeLibrary.id}}/authors" class="text-reset py-3 rounded-0" data-bs-toggle="tooltip" data-bs-placement="right"
            data-bs-title="Autores" aria-label="Autores" data-bs-original-title="Autores" data-bcup-haslogintext="no">
            <i class="fad fa-book-user"></i>
          </a>
        </li>
        <li>
          <a href="/libraries/vocabulary" class="text-reset py-3 rounded-0" data-bs-toggle="tooltip" data-bs-placement="right"
            data-bs-title="Vocabulario" aria-label="Vocabulario" data-bs-original-title="Vocabulario" data-bcup-haslogintext="no">
            <i class="fad fa-book"></i>
          </a>
        </li>
        <li>
          <a href="/libraries/favorites" class="text-reset py-3 rounded-0" data-bs-toggle="tooltip" data-bs-placement="right"
            data-bs-title="Favoritos" aria-label="Favoritos" data-bs-original-title="Favoritos" data-bcup-haslogintext="no">
            <i class="fad fa-star"></i>
          </a>
        </li>
        {{/if}}
      </ul>
      <div class="side-menu-bottom">
        {{#if activeLibrary}}
        <a href="/libraries/{{activeLibrary.id}}/settings" class="text-reset py-3 rounded-0" data-bs-toggle="tooltip" data-bs-placement="right"
          data-bs-title="Configuración" aria-label="Configuración" data-bs-original-title="Configuración" data-bcup-haslogintext="no">
        <i class="fas fa-cog"></i>
        </a>
        {{/if}}
      </div>
    </div>

    <div class="content-data">
      <div class="content-data-topbar">
        <div class="container-fluid">
          <div id="mcbntop-item-tools" class="align-items-center hstack gap-1">
            <div class="d-xxl-none">          
              <a href="/" class="d-block pt-2 px-3 link-dark text-decoration-none text-center" style="height: 54px;" data-bs-toggle="tooltip" data-bs-placement="right"
                data-bs-original-title="Icon-only" data-bcup-haslogintext="no">
                <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" aria-hidden="true" role="img" class="iconify iconify--mdi" width="30" height="30" preserveAspectRatio="xMidYMid meet" viewBox="0 0 24 24" data-icon="mdi:book-open-page-variant" data-width="30" data-height="30"><path fill="currentColor" d="m19 2l-5 4.5v11l5-4.5zM6.5 5C4.55 5 2.45 5.4 1 6.5v14.66c0 .25.25.5.5.5c.1 0 .15-.07.25-.07c1.35-.65 3.3-1.09 4.75-1.09c1.95 0 4.05.4 5.5 1.5c1.35-.85 3.8-1.5 5.5-1.5c1.65 0 3.35.31 4.75 1.06c.1.05.15.03.25.03c.25 0 .5-.25.5-.5V6.5c-.6-.45-1.25-.75-2-1V19c-1.1-.35-2.3-.5-3.5-.5c-1.7 0-4.15.65-5.5 1.5V6.5C10.55 5.4 8.45 5 6.5 5"></path></svg>
              </a>
            </div>
            <div class="p-2"><p class="h4 labrada">Librerías</p></div>
            <div class="p-2 ms-auto">
              <a href="/dataload" class="btn btn-warning">
                <i class="fa-duotone fa-add"></i>
              </a>
            </div>
            <div class="p-2">
              <button id="btn-search" class="btn btn-warning">
                <i class="fa-duotone fa-magnifying-glass"></i>
              </button>
            </div>

          </div>
        </div>
      </div>
      <div class="content-data-page">
        <div class="container-fluid">

          {{#if libraries.length}}
          <div id="libraries-container" class="row">
            <!-- Librerías dinámicas -->
            {{#each libraries}}
            <div class="col-12 col-xxl-3 {{#unless @first}}pt-2{{else}}pt-3{{/unless}} {{#unless @first}}pt-xxl-3{{/unless}}" id="library-{{this.id}}">
              <div class="card {{#if this.is_active}}active-library{{/if}}">
                <div class="card-body">
                  <h5 class="card-title"><i class="fa-duotone fa-server me-2"></i>{{this.name}}</h5>
                  <h6 class="card-subtitle mb-2 text-body-secondary">{{#if this.description}}{{this.description}}{{else}}Sin descripción{{/if}}</h6>
                  <p class="card-text"><i class="fa-duotone fa-books me-2"></i>{{this.bookCount}} libros con marcadores</p>
                  <a href="/libraries/{{this.id}}/settings" class="btn btn-outline-dark border-0"><i class="fad fa-cog"></i></a>
                  {{#if this.is_active}}
                  <a href="/libraries/{{this.id}}/books" class="btn btn-warning float-end"><i class="fa-duotone fa-books"></i></a>
                  {{else}}
                  <button class="btn btn-warning float-end btn-activate" data-id="{{this.id}}" data-name="{{this.name}}"><i class="fa-duotone fa-plug"></i></button>
                  {{/if}}
                </div>
              </div>
            </div>
            {{/each}}
            
            <!-- Librerías estáticas de ejemplo -->
            <div class="col-12 col-xxl-3 pt-3">
              <div class="card">
                <div class="card-body">
                  <h5 class="card-title"><i class="fa-duotone fa-server me-2"></i>Kobo Aura H20</h5>
                  <h6 class="card-subtitle mb-2 text-body-secondary">Con Backup</h6>
                  <p class="card-text"><i class="fa-duotone fa-books me-2"></i>42 libros con marcadores</p>
                  <a href="#" class="btn btn-outline-dark border-0"><i class="fad fa-cog"></i></a>
                  <button class="btn btn-warning float-end"><i class="fa-duotone fa-plug"></i></button>
                </div>
              </div>
            </div>
            <div class="col-12 col-xxl-3 pt-2 pt-xxl-3">
              <div class="card" style="">
                <div class="card-body">
                  <h5 class="card-title"><i class="fa-duotone fa-server me-2"></i>Kobo Elipsa</h5>
                  <h6 class="card-subtitle mb-2 text-body-secondary">Sin Backup</h6>
                  <p class="card-text"><i class="fa-duotone fa-books me-2"></i>28 libros con marcadores</p>
                  <a href="#" class="btn btn-outline-dark border-0"><i class="fad fa-cog"></i></a>
                  <button class="btn btn-warning float-end"><i class="fa-duotone fa-plug"></i></button>
                </div>
              </div>
            </div>
            <div class="col-12 col-xxl-3 pt-2 pt-xxl-3">
              <div class="card" style="">
                <div class="card-body">
                  <h5 class="card-title"><i class="fa-duotone fa-server me-2"></i>Kobo Elipsa 2023</h5>
                  <h6 class="card-subtitle mb-2 text-body-secondary">Sin Backup</h6>
                  <p class="card-text"><i class="fa-duotone fa-books me-2"></i>15 libros con marcadores</p>
                  <a href="#" class="btn btn-outline-dark border-0"><i class="fad fa-cog"></i></a>
                  <button class="btn btn-warning float-end"><i class="fa-duotone fa-plug"></i></button>
                </div>
              </div>
            </div>
          </div>
          {{else}}
          <div id="no-libraries-container" class="row">
            <div class="no-libraries">
              <span style="font-size: 3.5em;"><i class="fad fa-book-reader rounded-circle" style="background-color: #ffc107; padding: .35em .4em .35em .4em;"></i></span>
              <p class="h4 labrada pt-2">No hay librerías aún...</p>
              <p class="labrada pt-2">Agrega alguna base de datos.</p>
              <a href="/dataload" class="btn btn-warning mt-3">Añadir librería</a>
            </div>
          </div>
          <div id="libraries-container" class="row d-none">
            <!-- Librerías estáticas de ejemplo -->
            <div class="col-12 col-xxl-3 pe-xxl-0 pt-3">
              <div class="card">
                <div class="card-body">
                  <h5 class="card-title"><i class="fa-duotone fa-server me-2"></i>Kobo Aura H20</h5>
                  <h6 class="card-subtitle mb-2 text-body-secondary">Con Backup</h6>
                  <p class="card-text"><i class="fa-duotone fa-books me-2"></i>42 libros con marcadores</p>
                  <a href="#" class="btn btn-outline-dark border-0"><i class="fad fa-cog"></i></a>
                  <button class="btn btn-warning float-end"><i class="fa-duotone fa-plug"></i></button>
                </div>
              </div>
            </div>
            <div class="col-12 col-xxl-3 pt-2 pt-xxl-3">
              <div class="card" style="">
                <div class="card-body">
                  <h5 class="card-title"><i class="fa-duotone fa-server me-2"></i>Kobo Elipsa</h5>
                  <h6 class="card-subtitle mb-2 text-body-secondary">Sin Backup</h6>
                  <p class="card-text"><i class="fa-duotone fa-books me-2"></i>28 libros con marcadores</p>
                  <a href="#" class="btn btn-outline-dark border-0"><i class="fad fa-cog"></i></a>
                  <button class="btn btn-warning float-end"><i class="fa-duotone fa-plug"></i></button>
                </div>
              </div>
            </div>
            <div class="col-12 col-xxl-3 pt-2 pt-xxl-3">
              <div class="card" style="">
                <div class="card-body">
                  <h5 class="card-title"><i class="fa-duotone fa-server me-2"></i>Kobo Elipsa 2023</h5>
                  <h6 class="card-subtitle mb-2 text-body-secondary">Sin Backup</h6>
                  <p class="card-text"><i class="fa-duotone fa-books me-2"></i>15 libros con marcadores</p>
                  <a href="#" class="btn btn-outline-dark border-0"><i class="fad fa-cog"></i></a>
                  <button class="btn btn-warning float-end"><i class="fa-duotone fa-plug"></i></button>
                </div>
              </div>
            </div>
          </div>
          {{/if}}

        </div>
      </div>
    </div>
  </main>

  <!-- Modal para activar librería -->
  <div class="modal fade" id="activateLibraryModal" tabindex="-1" aria-labelledby="activateLibraryModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h1 class="modal-title fs-5" id="activateLibraryModalLabel"><i class="fad fa-plug me-2"></i>Activar librería</h1>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <p class="text-center">Esta acción cambiará la librería activa de marcadores</p>
          <p class="text-center">¿Estás seguro de que deseas activar la librería <strong id="libraryNameToActivate"></strong>?</p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="button" id="confirmActivateBtn" class="btn btn-warning">Activar</button>
        </div>
        <div class="modal-body mx-3 d-none" id="activationLoadingIndicator">
          <div class="d-flex align-items-center">
            <strong>Activando librería...</strong>
            <div class="spinner-border text-warning ms-auto" role="status" aria-hidden="true"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Toast para mensajes -->
  <div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="libraryToast" class="toast align-items-center text-bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
      <div class="d-flex">
        <div class="toast-body">
          <i class="fas fa-check-circle me-2"></i><span id="toastMessage"></span>
        </div>
        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
      </div>
    </div>
  </div>

  <script src="/static/libraries/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="https://code.iconify.design/2/2.2.1/iconify.min.js"></script>
  <script src="/static/js/library.js"></script>
</body>
</html>
